# What the code reads from the environment. Nothing in the repository loads this file by itself:
# set the variables in your shell, or put them in apps/web/.env.local, which Next.js reads for
# the web app (`pnpm stack:env --write` writes the local stack's there). .env and .env.* are
# ignored by git; this file is the exception and holds no key.

# The local database from compose.yaml (`docker compose up -d --wait`). Its password is for that
# container alone, which listens on 127.0.0.1 only. With this set, `pnpm test` and `pnpm check`
# run the database tests too, each in a database of its own that it removes afterwards.
DATABASE_URL=postgres://scena:scena-local-only@127.0.0.1:5435/scena

# ── Sign-in (the web app; docs/adr/0006-sign-in.md) ────────────────────────────────────────
# Sign-in is on when SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are both set, and off when neither
# is. With it on, the web app also needs SCENA_SITE_URL and a DATABASE_URL for the profiles,
# which for the web app is the local stack's database, not the one above.
# `pnpm stack:start` runs the local Supabase stack; `pnpm stack:env` prints all four for it.
# The values are read at run time from the CLI and are never written here.

# Supabase's API: the local stack's gateway, or https://<project>.supabase.co
SUPABASE_URL=
# The publishable key (sb_publishable_…, or the anon key of an older project). Never the secret
# or service-role key: the app refuses to start sign-in with one.
SUPABASE_PUBLISHABLE_KEY=
# This app's own origin, where the links in emails and the way back from Google lead:
# http://localhost:3100 for `pnpm dev:web`, https://app.<domain> when hosted.
SCENA_SITE_URL=
# "on" shows "Continue with Google" (the Supabase project must have Google switched on too).
SCENA_GOOGLE_SIGN_IN=off

# For the local stack only, read by the Supabase CLI when `pnpm stack:start` runs, and only
# when Google sign-in is to be tried locally. Never committed; Google's own console gives them.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=true
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
