{
  "name": "@scena/studio-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The studio as one self-contained HTML file that opens from disk: the build for pitching, and the demo pages.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@scena/renderer": "workspace:*",
    "@scena/scenes": "workspace:*",
    "@scena/studio": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.7",
    "vite-plugin-singlefile": "2.3.4"
  }
}
