{
  "name": "@scena/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The studio as a React component: arrange drawings or fill in a ready-made scene, attach links, preview and export the page. Mounted by the single-file build (apps/studio) and by the web app (apps/web).",
  "exports": {
    ".": "./src/index.ts",
    "./fonts": "./src/fonts.ts",
    "./policy": "./src/policy.ts",
    "./studio.css": "./src/studio.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@scena/renderer": "workspace:*",
    "@scena/scene": "workspace:*",
    "@scena/scenes": "workspace:*",
    "lucide-react": "1.70.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
